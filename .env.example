# ==============================================================================
# PC Remote - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Database Settings
POSTGRES_USER=pcremote
POSTGRES_PASSWORD=pcremote_secure_password_change_me
POSTGRES_DB=pc_remote
POSTGRES_PORT=5432

# Backend Connection URL (used by backend to connect to postgres container)
DATABASE_URL=postgresql://pcremote:pcremote_secure_password_change_me@postgres:5432/pc_remote

# Server Configuration
PORT=3000
NODE_ENV=production

# Security & JWT Secrets (MUST be changed in production, min 32 characters)
JWT_SECRET=change-this-jwt-secret-min-32-chars-long-security
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars-security

# Docker Container Registry Settings
GITHUB_REPOSITORY=hobbs1210/pc-remote

# Desktop Agent & Web App Backend URL
# URL of backend server where Agent & Web App should register & connect
SERVER_URL=http://localhost:3300
EXPO_PUBLIC_SERVER_URL=http://localhost:3300

# Web Container Port
WEB_PORT=8877
