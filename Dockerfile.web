# ── Stage 1: Build Web App ──────────────────────────────────────────────────
FROM node:24-slim AS builder

RUN npm install -g pnpm@9

WORKDIR /app

ARG SERVER_URL
ARG EXPO_PUBLIC_SERVER_URL
ENV EXPO_PUBLIC_SERVER_URL=${EXPO_PUBLIC_SERVER_URL:-$SERVER_URL}
ENV SERVER_URL=${SERVER_URL:-$EXPO_PUBLIC_SERVER_URL}

# Copy workspace dependency manifests for layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/mobile/package.json ./apps/mobile/

RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/mobile ./apps/mobile

# Build shared package and export static web bundle
RUN pnpm --filter @pc-remote/shared build
RUN pnpm --filter mobile build:web

# ── Stage 2: Web Server ─────────────────────────────────────────────────────
FROM nginx:alpine AS runner

# Copy built static files and Nginx configuration
COPY --from=builder /app/apps/mobile/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Add script to inject runtime container environment variables into env-config.js
RUN echo '#!/bin/sh' > /docker-entrypoint.d/30-env-config.sh && \
    echo 'URL="${SERVER_URL:-$EXPO_PUBLIC_SERVER_URL}"' >> /docker-entrypoint.d/30-env-config.sh && \
    echo 'cat <<EOF > /usr/share/nginx/html/env-config.js' >> /docker-entrypoint.d/30-env-config.sh && \
    echo 'window.__ENV__ = {' >> /docker-entrypoint.d/30-env-config.sh && \
    echo '  SERVER_URL: "${URL}"' >> /docker-entrypoint.d/30-env-config.sh && \
    echo '};' >> /docker-entrypoint.d/30-env-config.sh && \
    echo 'EOF' >> /docker-entrypoint.d/30-env-config.sh && \
    echo 'if ! grep -q "env-config.js" /usr/share/nginx/html/index.html; then' >> /docker-entrypoint.d/30-env-config.sh && \
    echo '  sed -i "s|<head>|<head><script src=\"/env-config.js\"></script>|g" /usr/share/nginx/html/index.html' >> /docker-entrypoint.d/30-env-config.sh && \
    echo 'fi' >> /docker-entrypoint.d/30-env-config.sh && \
    chmod +x /docker-entrypoint.d/30-env-config.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
