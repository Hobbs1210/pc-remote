{
  "name": "backend",
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @pc-remote/shared build",
    "dev": "tsx watch src/app.ts",
    "build": "prisma generate && tsc && node -e \"import('node:fs').then(fs => fs.cpSync('src/views', 'dist/views', {recursive: true, force: true}))\"",
    "start": "prisma db push --accept-data-loss && node dist/app.js",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.0",
    "@fastify/jwt": "^8.0.0",
    "@pc-remote/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "prisma": "^5.22.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}